# Shadow Protocol bridge configuration (spec §4.4).
# Copy to .env and fill in. NEVER commit .env with a real MN_DEPLOYER_SEED.

# --- mode ---
# mock    = in-process simulated ledger (same circuit checks, no chain) — runs
#           out of the box, use while the toolchain/faucet are being set up
# testnet = real Midnight testnet (requires compiled contract, proof server,
#           funded deployer wallet)
MN_MODE=mock

# --- network ---
MN_NETWORK_ID=TestNet                # VERIFY-AGAINST-DOCS: enum name in @midnight-ntwrk/midnight-js-network-id
MN_INDEXER_URL=                      # public testnet indexer URL from docs quickstart
MN_INDEXER_WS_URL=                   # websocket variant
MN_NODE_URL=                         # public testnet node RPC from docs quickstart
MN_PROOF_SERVER_URL=http://127.0.0.1:6300

# --- wallet ---
MN_DEPLOYER_SEED=                    # 64-hex headless wallet seed; fund with tDUST from faucet; NEVER commit real value

# --- contract ---
MN_CONTRACT_ADDRESS=                 # empty => bridge deploys fresh on boot and prints the address

# --- bridge ---
BRIDGE_PORT=5310
BRIDGE_BIND=127.0.0.1               # localhost only; never expose
LOG_LEVEL=info
DEMO_FIXED_SEED=                     # 64-hex; test-mode only, forces deterministic deal for B1 test + rehearsals

# --- match size ---
# 5 = spec-locked (1 Saboteur + 4 Agents). Set 2..4 for dev testing with fewer
# game windows; must match SHADOW_PLAYERS on the Python side.
MN_REQUIRED_PLAYERS=5
